# Database (PostgreSQL)
# Docker Compose: DB_HOST=db (port is NOT published to the host)
# Local (no Docker): DB_HOST=127.0.0.1 and update both URLs below
POSTGRES_USER=kabana_user
POSTGRES_PASSWORD=change_me_strong_db_password
POSTGRES_DB=kabana_db
DB_HOST=db
DATABASE_URL=postgresql+asyncpg://kabana_user:change_me_strong_db_password@db:5432/kabana_db
SYNC_DATABASE_URL=postgresql://kabana_user:change_me_strong_db_password@db:5432/kabana_db

# Runtime: dev | prod  (prod enforces strong SECRET_KEY and disables /docs)
ENVIRONMENT=dev

# Security — generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_secrets_token_urlsafe_48_chars_minimum_xxxx
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Optional override; default: Secure cookies when BASE_URL is https://
# COOKIE_SECURE=true

# File Storage — clients never hit FTP/DL host directly; app proxies via /media/proxy/*
MEDIA_ROOT=/app/storage
FTP_ENABLED=True
FTP_HOST=ftp
FTP_PORT=21
FTP_USER=ftp_user
FTP_PASS=ftp_pass
FTP_BASE_DIR=

# Scraper
SCRAPER_CONCURRENCY=20
SCRAPER_LOOP_INTERVAL=3600
# Books buffered before each DB write (higher = fewer commits, more loss risk on kill)
SCRAPER_FLUSH_SIZE=25
SCRAPER_FLUSH_TIMEOUT=5
# Optional outbound proxy when asbook blocks the VPS IP (HTTP or SOCKS)
# SCRAPER_PROXY=http://user:pass@host:8080
# SCRAPER_PROXY=socks5://127.0.0.1:1080
# Also accepts standard HTTPS_PROXY / HTTP_PROXY / ALL_PROXY

# First admin (auto-created on boot if no admin exists)
ADMIN_PHONE=09120000000
ADMIN_PASSWORD=change_me_strong_admin_password
ADMIN_FIRST_NAME=مدیر
ADMIN_LAST_NAME=سیستم
ADMIN_EMAIL=admin@example.com

# Frontend / public URLs (use https:// in production)
DOMAIN_NAME=example.com
BASE_URL=http://localhost:8000
# Let's Encrypt account email (required by scripts/setup_ssl.sh)
SSL_EMAIL=ops@example.com

# Kabana theme license (راست‌چین) — set your purchase code
KABANA_LICENSE=

# Zibal payment gateway (merchant=zibal = official sandbox)
ZIBAL_MERCHANT=zibal
ZIBAL_CALLBACK_URL=http://localhost:8000/payment/callback/zibal

# pgAdmin (docker compose --profile dev only)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
